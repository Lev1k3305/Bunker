{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-04-26",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // ВРЕМЕННО отключено: у текущего Cloudflare API-токена нет прав на D1.
  // Как только права будут добавлены (Account -> D1 -> Edit) и база создана,
  // нужно вернуть этот блок с реальным database_id.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "webapp-production",
  //     "database_id": "local-placeholder-id"
  //   }
  // ],
  "vars": {
    // Несекретная настройка модели Groq для ботов. Сам ключ GROQ_API_KEY
    // хранится ТОЛЬКО как секрет: локально в .dev.vars (не коммитится),
    // в продакшене — через `wrangler pages secret put GROQ_API_KEY`.
    "GROQ_MODEL": "openai/gpt-oss-120b"
  }
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // }
}